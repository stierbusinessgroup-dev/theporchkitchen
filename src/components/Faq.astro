---
import { faqs } from '../data/faq';
---

<section class="faq" id="faq">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Good to know</p>
      <h2>Frequently Asked Questions</h2>
    </div>
    <div class="faq-list">
      {
        faqs.map((f) => (
          <details class="faq-item">
            <summary>
              <span class="q">{f.q}</span>
              <span class="icon" aria-hidden="true" />
            </summary>
            <div class="a">
              <p>{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--paper);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .faq-list {
    max-width: 760px;
    margin: 0 auto;
  }
  .faq-item {
    border-bottom: 1px solid var(--line);
  }
  .faq-item:first-child {
    border-top: 1px solid var(--line);
  }
  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 4px;
    font-family: var(--serif);
    font-size: 1.35rem;
    line-height: 1.3;
    color: var(--ink);
    transition: color 0.18s;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--sage-dk);
  }
  .faq-item:focus-within summary {
    color: var(--sage-dk);
  }
  /* Plus → minus indicator (rotates the vertical bar away on open). */
  .icon {
    position: relative;
    flex: none;
    width: 16px;
    height: 16px;
    margin-top: 4px;
  }
  .icon::before,
  .icon::after {
    content: '';
    position: absolute;
    background: var(--clay);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .icon::before {
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    transform: translateY(-50%);
  }
  .icon::after {
    left: 50%;
    top: 0;
    height: 100%;
    width: 1.5px;
    transform: translateX(-50%);
  }
  .faq-item[open] .icon::after {
    transform: translateX(-50%) scaleY(0);
    opacity: 0;
  }
  .a {
    padding: 0 4px 24px;
    max-width: 660px;
  }
  .a p {
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.65;
    margin: 0;
  }
  @media (max-width: 680px) {
    summary {
      font-size: 1.18rem;
      padding: 18px 2px;
    }
  }
</style>
