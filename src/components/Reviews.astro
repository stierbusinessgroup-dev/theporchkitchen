---
import Texture from './Texture.astro';
// Note: only the genuine Yelp quote is shown. Numeric review counts were left out
// until verified — add a real aggregateRating here (and in JsonLd) once confirmed.
const facts = [
  'Women-owned',
  'Made from scratch',
  'Local & seasonal',
  'Behind The Barlow',
];
---

<section class="reviews has-tex">
  <Texture />
  <div class="wrap">
    <p class="stars" aria-hidden="true">★★★★★</p>
    <blockquote class="quote">
      “The best turkey sandwich I've ever had — the soup's spices, the beet salad… and the space is
      so cute. We'll be back.”
    </blockquote>
    <p class="quote-by">— Kaci W. on Yelp</p>
    <ul class="fact-row">
      {facts.map((f) => <li>{f}</li>)}
    </ul>
  </div>
</section>

<style>
  .reviews {
    background: var(--cream);
    text-align: center;
  }
  .stars {
    color: var(--gold);
    font-size: 1.5rem;
    letter-spacing: 0.1em;
  }
  .quote {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    max-width: 780px;
    margin: 18px auto 14px;
    color: var(--ink);
    line-height: 1.3;
  }
  .quote-by {
    color: var(--muted);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .fact-row {
    list-style: none;
    display: flex;
    gap: 14px 26px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 40px;
  }
  .fact-row li {
    color: var(--sage-dk);
    font-family: var(--serif);
    font-size: 1.15rem;
    position: relative;
    padding-left: 22px;
  }
  .fact-row li::before {
    content: '✶';
    position: absolute;
    left: 0;
    color: var(--gold);
  }
</style>
