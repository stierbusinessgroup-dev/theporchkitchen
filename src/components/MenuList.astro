---
// Presentational renderer for one Menu object (sections + items + dietary tags).
// Used by the homepage lunch preview and the dedicated /menu page.
import type { Menu } from '../data/menu';
import { DIET_LABELS } from '../data/menu';

interface Props {
  menu: Menu;
  /** Show the "Served …" caption under the title. */
  showServed?: boolean;
}
const { menu, showServed = false } = Astro.props;
---

<div class="menu-block">
  {showServed && <p class="served">{menu.served}</p>}
  <div class="menu-grid">
    {
      menu.sections.map((sec) => (
        <div class="menu-cat">
          <h3>
            {sec.title}
            {sec.note && <span class="cat-note">{sec.note}</span>}
          </h3>
          {sec.items.map((it) => (
            <div class="item">
              <div class="nm">
                {it.name}
                {it.tags?.map((t) => (
                  <abbr class={`tag tag-${t}`} title={DIET_LABELS[t]}>
                    {t}
                  </abbr>
                ))}
                {it.desc && <small>{it.desc}</small>}
              </div>
              <div class="pr">{it.price != null ? it.price.toFixed(2) : it.priceText ?? '—'}</div>
            </div>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .served {
    text-align: center;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--sage-dk);
    margin-bottom: 30px;
  }
  .menu-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 44px 64px;
  }
  .menu-cat h3 {
    font-size: 1.5rem;
    color: var(--sage-dk);
    margin-bottom: 6px;
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .menu-cat h3::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
  }
  .cat-note {
    font-family: var(--serif);
    font-size: 1.05rem;
    color: var(--clay);
    flex: none;
  }
  .menu-cat h3:has(.cat-note)::after {
    display: none;
  }
  .item {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 9px 0;
    border-bottom: 1px dotted var(--line);
  }
  .item:last-child {
    border-bottom: none;
  }
  .nm {
    font-weight: 400;
  }
  .nm small {
    display: block;
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 300;
    margin-top: 2px;
  }
  .pr {
    font-family: var(--serif);
    font-size: 1.15rem;
    color: var(--clay);
    white-space: nowrap;
  }
  .tag {
    font-size: 0.6rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 600;
    border: 1px solid var(--sage);
    color: var(--sage);
    border-radius: 2px;
    padding: 1px 4px;
    margin-left: 6px;
    vertical-align: middle;
    text-decoration: none;
    cursor: help;
  }
  .tag-s {
    border-color: var(--clay);
    color: var(--clay);
  }
  @media (max-width: 820px) {
    .menu-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
