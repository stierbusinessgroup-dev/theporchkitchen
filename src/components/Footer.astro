---
import { site } from '../data/site';
const year = 2026;
---

<footer>
  <div class="wrap">
    <div class="foot">
      <div class="foot-brand">
        <a class="brand" href="/">
          The Porch Kitchen
          <small>by {site.parent}</small>
        </a>
        <p class="blurb">{site.tagline} Sebastopol, Sonoma County.</p>
        <div class="cta-row foot-cta">
          <a class="btn btn-solid" href={site.toastOrderUrl} target="_blank" rel="noopener">
            Order Online
          </a>
          <a class="btn btn-on-dark" href="/menu">View Menu</a>
        </div>
        <div class="social">
          <a href={site.instagram} target="_blank" rel="noopener" aria-label="The Porch Kitchen on Instagram">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="currentColor"><path d="M12 2.2c3.2 0 3.6 0 4.9.07 1.2.06 1.8.25 2.2.42.6.22 1 .48 1.4.9.43.42.7.82.92 1.4.17.42.36 1 .42 2.2.06 1.3.07 1.7.07 4.9s0 3.6-.07 4.9c-.06 1.2-.25 1.8-.42 2.2-.22.6-.49 1-.92 1.4-.42.43-.82.7-1.4.92-.42.17-1 .36-2.2.42-1.3.06-1.7.07-4.9.07s-3.6 0-4.9-.07c-1.2-.06-1.8-.25-2.2-.42-.6-.22-1-.49-1.4-.92-.43-.42-.7-.82-.92-1.4-.17-.42-.36-1-.42-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.9c.06-1.2.25-1.8.42-2.2.22-.6.49-1 .92-1.4.42-.43.82-.7 1.4-.92.42-.17 1-.36 2.2-.42C8.4 2.2 8.8 2.2 12 2.2Zm0 1.8c-3.1 0-3.5 0-4.7.07-1.1.05-1.7.24-2.1.4-.5.2-.9.43-1.3.83-.4.4-.64.8-.83 1.3-.16.4-.35 1-.4 2.1C2.6 9.7 2.6 10.1 2.6 13s0 3.3.07 4.5c.05 1.1.24 1.7.4 2.1.2.5.43.9.83 1.3.4.4.8.64 1.3.83.4.16 1 .35 2.1.4 1.2.07 1.6.07 4.7.07s3.5 0 4.7-.07c1.1-.05 1.7-.24 2.1-.4.5-.2.9-.43 1.3-.83.4-.4.64-.8.83-1.3.16-.4.35-1 .4-2.1.07-1.2.07-1.6.07-4.5s0-3.3-.07-4.5c-.05-1.1-.24-1.7-.4-2.1-.2-.5-.43-.9-.83-1.3-.4-.4-.8-.64-1.3-.83-.4-.16-1-.35-2.1-.4C15.5 4 15.1 4 12 4Zm0 3.06A4.94 4.94 0 1 1 7.06 12 4.94 4.94 0 0 1 12 7.06Zm0 8.14A3.2 3.2 0 1 0 8.8 12 3.2 3.2 0 0 0 12 15.2Zm5.14-8.34a1.15 1.15 0 1 1-1.15-1.15 1.15 1.15 0 0 1 1.15 1.15Z"/></svg>
          </a>
          <a href={site.facebook} target="_blank" rel="noopener" aria-label="The Porch Kitchen on Facebook">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12Z"/></svg>
          </a>
        </div>
      </div>

      <div class="foot-col">
        <h2>Visit</h2>
        <a href="/menu">Menu</a>
        <a href="/#happy-hour">Happy Hour</a>
        <a href="/#visit">Hours &amp; Location</a>
        <a href={site.mapDirectionsUrl} target="_blank" rel="noopener">Directions</a>
      </div>

      <div class="foot-col">
        <h2>The Company</h2>
        <a href="/#catering">Catering &amp; Events</a>
        <a href="/#about">About Lisa &amp; Kevin</a>
        <a href={site.parentUrl} target="_blank" rel="noopener">The Cook &amp; The Drummer</a>
        <a href={site.phoneHref}>{site.phoneDisplay}</a>
      </div>
    </div>

    <div class="legal">
      <span>© {year} {site.name} · {site.parent}</span>
      <span>{site.address.street}, {site.address.locality}, {site.address.region} · {site.phoneDisplay}</span>
    </div>
  </div>
</footer>

<style>
  footer {
    background: var(--dark);
    color: #c9c4bd;
    padding: 56px 0 30px;
  }
  .foot {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 36px;
  }
  .brand {
    font-family: var(--serif);
    font-size: 1.5rem;
    color: #fff;
    line-height: 1;
  }
  .brand small {
    display: block;
    font-family: var(--sans);
    font-size: 0.56rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #8d8674;
    font-weight: 600;
    margin-top: 4px;
  }
  .blurb {
    margin-top: 14px;
    font-size: 0.92rem;
    max-width: 320px;
  }
  .foot-cta {
    margin-top: 18px;
  }
  .social {
    display: flex;
    gap: 14px;
    margin-top: 20px;
  }
  .social a {
    color: #cfc9ba;
    transition: 0.18s;
  }
  .social a:hover {
    color: #fff;
  }
  .foot-col h2 {
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8d8674;
    margin-bottom: 14px;
    font-weight: 600;
  }
  .foot-col a {
    display: block;
    padding: 4px 0;
    color: #cfc9ba;
    font-size: 0.92rem;
  }
  .foot-col a:hover {
    color: #fff;
  }
  .legal {
    border-top: 1px solid #3a382f;
    margin-top: 40px;
    padding-top: 20px;
    font-size: 0.78rem;
    color: #8d8674;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
  }
  @media (max-width: 680px) {
    .foot {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
