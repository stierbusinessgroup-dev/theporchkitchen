---
import { site } from '../data/site';
---

<section class="band">
  <div class="wrap">
    <p class="eyebrow band-eyebrow">Grab &amp; go</p>
    <h2>Order ahead, skip the wait</h2>
    <p>
      A picnic in the vineyards, a bite between errands, or lunch back at the desk — order ahead and
      it's boxed and ready when you walk in. Salads, sandwiches, and grain bowls made by hand that
      morning.
    </p>
    <div class="cta-row band-cta">
      <a class="btn btn-light" href={site.toastOrderUrl} target="_blank" rel="noopener">
        Order Online
      </a>
      <a class="btn btn-on-dark" href="/menu">View the Menu</a>
    </div>
  </div>
</section>

<style>
  .band {
    background: var(--dark);
    color: #d8d3cc;
    text-align: center;
  }
  .band-eyebrow {
    color: #a59f97;
  }
  .band h2 {
    color: #fff;
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    margin: 10px 0;
  }
  .band p {
    opacity: 0.9;
    max-width: 560px;
    margin: 0 auto 26px;
  }
  .band-cta {
    justify-content: center;
  }
</style>
