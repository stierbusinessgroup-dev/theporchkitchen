---
import { site } from '../data/site';
const mapSrc = `https://www.google.com/maps?q=${site.mapEmbedQuery}&output=embed`;
---

<section class="visit" id="visit">
  <div class="wrap">
    <div class="map-wrap">
      <iframe
        src={mapSrc}
        title={`Map to ${site.name}, ${site.address.street}, ${site.address.locality}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        width="100%"
        height="100%"></iframe>
    </div>
    <div class="info">
      <p class="eyebrow">Find us</p>
      <h2>Visit The Porch</h2>
      <dl>
        <dt>Address</dt>
        <dd>
          <a href={site.mapDirectionsUrl} target="_blank" rel="noopener">
            {site.address.street}, {site.address.locality}, {site.address.region}
            {site.address.postalCode}
          </a>
          <span class="near">{site.address.neighborhood}</span>
        </dd>
        <dt>Phone</dt>
        <dd><a href={site.phoneHref}>{site.phoneDisplay}</a></dd>
        <dt>Hours</dt>
        <dd class="hours">
          {
            site.hoursRows.map((r) => (
              <div class="hours-row">
                <span>{r.label}</span>
                <span>{r.value}</span>
              </div>
            ))
          }
          <p class="hh-line">Happy Hour {site.happyHour.days}, {site.happyHour.time}</p>
        </dd>
      </dl>
      <div class="cta-row visit-cta">
        <a class="btn btn-solid" href={site.toastOrderUrl} target="_blank" rel="noopener">
          Order Online
        </a>
        <a class="btn btn-ghost" href={site.mapDirectionsUrl} target="_blank" rel="noopener">
          Get Directions
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .visit .wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: stretch;
  }
  .map-wrap {
    min-height: 340px;
    border-radius: 3px;
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .map-wrap iframe {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 340px;
    border: 0;
    filter: saturate(0.9);
  }
  .info h2 {
    font-size: 2.2rem;
    margin: 8px 0 6px;
  }
  .info dt {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--clay);
    font-weight: 600;
    margin-top: 22px;
  }
  .info dd {
    font-size: 1.05rem;
    margin-top: 4px;
  }
  .info dd a {
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 3px;
  }
  .near {
    display: block;
    color: var(--muted);
    font-size: 0.9rem;
    margin-top: 2px;
  }
  .hours-row {
    display: flex;
    justify-content: space-between;
    max-width: 360px;
    padding: 5px 0;
    border-bottom: 1px dotted var(--line);
  }
  .hh-line {
    margin-top: 10px;
    font-style: italic;
    font-family: var(--serif);
    font-size: 1.1rem;
    color: var(--sage-dk);
  }
  .visit-cta {
    margin-top: 26px;
  }
  @media (max-width: 820px) {
    .visit .wrap {
      grid-template-columns: 1fr;
    }
  }
</style>
