---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import MenuPreview from '../components/MenuPreview.astro';
import HappyHour from '../components/HappyHour.astro';
import OrderBand from '../components/OrderBand.astro';
import Catering from '../components/Catering.astro';
import About from '../components/About.astro';
import Reviews from '../components/Reviews.astro';
import Gallery from '../components/Gallery.astro';
import Visit from '../components/Visit.astro';
import { site } from '../data/site';
---

<Base
  title="The Porch Kitchen — Farm-Fresh Lunch, Happy Hour & Dinner in Sebastopol"
  description={site.metaDescription}
  path="/"
  type="restaurant"
>
  <Nav slot="header" />

  <Hero />
  <Intro />
  <MenuPreview />
  <HappyHour />
  <OrderBand />
  <Catering />
  <About />
  <Gallery />
  <Reviews />
  <Visit />

  <Footer slot="footer" />
</Base>
